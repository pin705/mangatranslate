# Copy to infra/deploy/.env on the server (staging and production each have their OWN values). Never commit .env.
APP_ENV=production                      # local | staging | production
DOMAIN=app.example.com
GITHUB_REPOSITORY=your-org/mangatranslate
WEB_URL=https://app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
CSP_STORAGE_ORIGIN=https://<account-id>.r2.cloudflarestorage.com   # browsers upload/load images here
CORS_ORIGINS=https://app.example.com
AUTH_SECRET=                            # openssl rand -hex 32

# Managed Postgres with point-in-time recovery
DATABASE_URL=postgresql+psycopg://user:password@host:5432/mangatranslate?sslmode=require

# Cloudflare R2 (S3 API). Separate bucket per environment.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mangatranslate-prod
S3_REGION=auto
MAX_UPLOAD_MB=200

# Heavy page tasks queue: "default" (CPU workers) or "gpu" (run the worker-gpu service)
MODEL_QUEUE=default

# AI providers — seeded into the providers table on first worker start, then managed in /admin/providers.
# Rows reference key variables by name; keys themselves stay here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-5.4-mini
TRANSLATION_FALLBACK_BASE_URL=          # optional, e.g. https://api.deepseek.com/v1
TRANSLATION_FALLBACK_MODEL=deepseek-chat
TRANSLATION_FALLBACK_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
OCR_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OCR_MODEL=qwen3-vl-flash
OCR_API_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=
SEGMENTER=onnx                           # onnx | none (model-free mask)

# Payments: payOS (VietQR). "dev" is refused when APP_ENV=production.
PAYMENT_PROVIDERS=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# E-mail via any SMTP relay (Resend, SES, Postmark, ...)
EMAIL_PROVIDER=smtp
EMAIL_FROM=MangaTranslate AI <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
