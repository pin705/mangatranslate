# Automatic HTTPS. Put Cloudflare in front (proxied DNS, SSL mode "Full (strict)") and firewall ports 80/443 to
# Cloudflare's IP ranges only: the API trusts CF-Connecting-IP for rate limiting.
{$DOMAIN} {
	encode zstd gzip
	@api path /api/* /health /ready
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
